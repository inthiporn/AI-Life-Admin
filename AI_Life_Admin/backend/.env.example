# Local emulator config only (Firebase Functions loads .env automatically in the emulator).
# In production, set these as Cloud Functions secrets instead:
#   firebase functions:secrets:set PAYMENT_GATEWAY_API_KEY
#   firebase functions:secrets:set OCR_PROVIDER_API_KEY
# Never commit a real .env file — it is git-ignored.

PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_BASE_URL=

OCR_PROVIDER_API_KEY=
OCR_PROVIDER_BASE_URL=
